# ── Frontend (safe to expose — these ship in the browser bundle) ──────────────
# Both come from: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# The URL of the deployed admin-api Edge Function.
# Default is `${VITE_SUPABASE_URL}/functions/v1/admin-api` — only set this if
# you host the function elsewhere.
# VITE_ADMIN_API_URL=

# ──────────────────────────────────────────────────────────────────────────────
# NOTE: The following are SERVER-SIDE ONLY. They are NOT prefixed with VITE_ and
# must NEVER appear in the frontend. They are configured as Supabase Edge
# Function secrets (see README), not in this .env used by Vite.
#
#   SUPABASE_URL                 (auto-provided to Edge Functions)
#   SUPABASE_SERVICE_ROLE_KEY    (auto-provided to Edge Functions)
#   ADMIN_JWT_SECRET             (you generate this — long random string)
# ──────────────────────────────────────────────────────────────────────────────
